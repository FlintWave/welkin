# OpenSim Rust — Production Environment Configuration
# ============================================================================
# Copy this file to .env and edit the values before running:
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose -f docker-compose.prod.yml up -d
#
# IMPORTANT: Change all passwords and secrets before deploying.
#
# SPDX-License-Identifier: LGPL-3.0-or-later
# ============================================================================

# ── Image Configuration ─────────────────────────────────────────────
# Tag for pre-built images.  Set to a release tag (e.g. 0.2.0) or
# "latest" for the most recent build.
IMAGE_TAG=latest

# ── Database (MySQL 8.0) ────────────────────────────────────────────
# These are used by the db service entrypoint to initialise the
# database on first run.  After that, only OPENSIM_DB_CONNECTION matters.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=opensim
MYSQL_USER=opensim
MYSQL_PASSWORD=change-me-opensim-password

# Connection string consumed by Robust, Region, and Portal.
# The hostname "db" matches the docker-compose service name.
OPENSIM_DB_CONNECTION=Server=db;Port=3306;Database=opensim;User=opensim;Password=change-me-opensim-password

# ── Robust (Grid Services) ──────────────────────────────────────────
# HTTP port for login, asset, inventory, grid, and other services.
ROBUST_PORT=8002
ROBUST_HTTP_PORT=8002

# ── Region Simulator ────────────────────────────────────────────────
# HTTP port (caps, mesh upload) and LLUDP port (viewer protocol).
# Both use the same port number; TCP for HTTP, UDP for LLUDP.
REGION_PORT=9000
REGION_HTTP_PORT=9000

# URI where the region finds grid services (Robust).
# Must match the robust service's internal hostname and port.
REGION_GRID_URI=http://robust:8002

# ── Portal (Web Admin) ──────────────────────────────────────────────
PORTAL_PORT=8080
PORTAL_HTTP_PORT=8080
PORTAL_GRID_URI=http://robust:8002

# ── WolfVoice (Voice Sidecar) ──────────────────────────────────────
# Shared secret between the region server and the voice service.
# Generate a strong random value:  openssl rand -hex 32
WOLFVOICE_SECRET_KEY=change-me-voice-secret
WOLFVOICE_PORT=8090

# ── Logging ─────────────────────────────────────────────────────────
# RUST_LOG controls tracing-subscriber's EnvFilter.  Examples:
#
#   RUST_LOG=info                      Default, recommended for production
#   RUST_LOG=debug                     Verbose output from all crates
#   RUST_LOG=opensim_robust=debug      Verbose for one crate only
#   RUST_LOG=warn                      Quiet — errors and warnings only
#   RUST_LOG=opensim_scene=trace       Deep diagnostics for scene updates
#
RUST_LOG=info

# Set to "true" for JSON-structured log lines (machine-parseable).
OPENSIM_LOG_JSON=false

# ── Prometheus Metrics ──────────────────────────────────────────────
# Metrics are served at /metrics on each service's own HTTP port.
# No separate metrics port is needed.  Configure Prometheus to scrape:
#
#   - robust:8002/metrics
#   - region:9000/metrics
#   - portal:8080/metrics
#
# Example prometheus.yml scrape config:
#
#   scrape_configs:
#     - job_name: opensim
#       static_configs:
#         - targets:
#           - robust:8002
#           - region:9000
#           - portal:8080

# ── Scheduled Backups ───────────────────────────────────────────────
# Cron expression for the optional backup sidecar (see docker-compose.prod.yml).
# Default: 4 AM daily.
BACKUP_CRON=0 4 * * *

# ── Graceful Shutdown ───────────────────────────────────────────────
# Docker stop timeout in seconds.  For region servers with active
# viewers, increase this to allow terrain saves and viewer disconnects.
# Default Docker timeout is 10s; 30s is recommended for regions.
#
# Set in docker-compose.prod.yml via stop_grace_period, or override:
#   docker stop --time=30 <container>
