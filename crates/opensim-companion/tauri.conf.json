{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicetauri/master/packages/tauri/schema.json",
  "productName": "OpenSimulator Companion",
  "version": "0.1.0",
  "identifier": "org.opensimulator.companion",
  "build": {
    "frontendDist": "../opensim-portal"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenSimulator Companion",
        "url": "http://localhost:8002/",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "OpenSimulator"
    },
    "security": {
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "localhost",
          "windows": ["main"],
          "enableTauriAPI": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "opensim-companion.desktop"
      },
      "rpm": {}
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "permission": true
    }
  }
}
